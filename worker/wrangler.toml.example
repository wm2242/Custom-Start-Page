name = "startpage-sync-worker"
main = "worker.js"
compatibility_date = "2025-01-01"

# 非敏感环境变量（敏感项请用 `wrangler secret put` 配置）
[vars]
S3_ENDPOINT = "https://s3.amazonaws.com"
S3_REGION = "us-east-1"
S3_BUCKET = "your-bucket"
CORS_ALLOWED_ORIGIN = "https://your-start.pages.dev"
MAX_BODY_SIZE = "10485760"
OBJECT_KEY_PREFIX = "backup/"
# API_ACCESS_TOKEN = "optional-token"

# 必须通过 Secret 配置（不要写在这里）：
# S3_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY
# 可选：API_ACCESS_TOKEN
